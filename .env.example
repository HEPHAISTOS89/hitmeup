# Public configuration only. Keep actual secrets in hosted secret storage.
NEXT_PUBLIC_SUPABASE_URL=https://olifkkohqhkcottaiqbs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key; never expose to browser bundles.
SUPABASE_SECRET_KEY=
AUTH0_DOMAIN=dev-yc4m6ynew2zzqzwu.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional dedicated HMAC key for pseudonymous shared rate-limit buckets.
# If omitted, AUTH0_SECRET is used. Keep at least 32 characters.
RATE_LIMIT_SALT=
# Development/test only opt-in; production always requires the shared limiter.
SHARED_RATE_LIMIT_ENABLED=false
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_EDU_DOMAINS=ttu.edu
AUTH0_MICROSOFT_STRATEGIES=waad,windowslive
# Auth0 connection name used to skip Universal Login and open Microsoft Entra directly.
AUTH0_MICROSOFT_CONNECTION=ttu-development
# Optional: set to the exact university Microsoft Entra tenant id.
AUTH0_MICROSOFT_TID=

# Optional public MapLibre style overrides. Defaults use OpenFreeMap and require no API key.
NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark

# Server-only. Do not commit the value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solana Devnet only for the hackathon demo. These are server-only values.
SOLANA_NETWORK=devnet
SOLANA_TREASURY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional append-only analytics. Disabled unless explicitly enabled and configured.
TIGER_DATA_ENABLED=false
TIGER_DATA_INGEST_URL=
TIGER_DATA_API_KEY=
TIGER_DATA_SALT=
TIGER_DATABASE_URL=
